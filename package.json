{
  "name": "lockin-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "Shared",
    "TauriBuild"
  ],
  "scripts": {
    "dev": "bun run --filter @lockin/tauri dev",
    "build": "bun run --filter @lockin/tauri build",
    "tauri:dev": "bun run --filter @lockin/tauri tauri:dev",
    "tauri:build": "bun run --filter @lockin/tauri tauri:build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
