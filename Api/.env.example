# Zkopíruj na .env a vyplň. .env je v .gitignore, nikdy ho necommituj.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# V Dockeru je hostitel název služby z compose ("postgres"), ne localhost.
DATABASE_URL=postgresql://lockin:zmen_me@localhost:5432/lockin?schema=public

# Vygeneruj: openssl rand -base64 48
JWT_SECRET=zmen_me_na_nahodny_retezec_aspon_32_znaku
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Čárkou oddělené originy, ze kterých smí chodit prohlížeč.
CORS_ORIGINS=http://localhost:3000

MEDIA_DIR=./data/media
MAX_UPLOAD_BYTES=52428800
DEFAULT_STORAGE_QUOTA_BYTES=2147483648

# Veřejná adresa API — zapéká se do webového bundlu při buildu.
PUBLIC_API_URL=https://lockinapi.honzacies.dev
