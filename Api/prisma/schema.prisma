// LockIn API — datový model
//
// Dokumenty a projekty jsou pro server **neprůhledné**. Šifrují se v prohlížeči
// klíčem, který server nikdy nevidí, a sem přijde jen ciphertext plus nejmenší
// možná čitelná obálka (adresace a časy). Server tedy neumí podle obsahu řadit
// ani filtrovat — a nemusí, protože klient si přes `/sync` stahuje všechno a
// filtruje si sám.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(USER)

  /// Kvóta na média v bajtech. Default 2 GB, admin může zvednout jednotlivci.
  /// BigInt, protože Int by přetekl u 2 GB+ (max ~2,1 mld.).
  storageQuota BigInt    @default(2147483648)
  /// Průběžně dopočítávaný součet MediaFile.bytes — ať se nemusí sčítat při
  /// každém uploadu.
  storageUsed  BigInt    @default(0)

  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  key           UserKey?
  inviteCode    InviteCode?
  projects      Project[]
  documents     Document[]
  media         MediaFile[]
  collections   Collection[]
  refreshTokens RefreshToken[]

  @@index([createdAt])
}

/// Obalený hlavní klíč uživatele.
///
/// Passphrase nešifruje dokumenty — šifruje tenhle jediný záznam. Změna
/// passphrase tedy přepíše jeden řádek a dokumentů se vůbec nedotkne, ať jich
/// je pět nebo pět tisíc.
///
/// Server drží jen obalenou podobu a parametry odvození. Passphrase, odvozený
/// klíč ani hlavní klíč se sem nikdy nedostanou.
model UserKey {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Vše base64. `wrappedKey` je hlavní klíč zašifrovaný klíčem odvozeným
  /// z passphrase, `nonce` patří k němu.
  salt       String
  wrappedKey String
  nonce      String

  /// Parametry odvození se ukládají s klíčem, aby šlo později zesílit
  /// nastavení, aniž by se rozbily existující účty.
  algorithm   String @default("argon2id")
  memoryKiB   Int    @default(65536)
  iterations  Int    @default(3)
  parallelism Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Jednorázový — jeden kód = jeden účet. Po registraci se spálí (`usedAt`,
/// `usedById`), takže v administraci je vidět, kdo který kód použil a kdy.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  /// Volitelná poznámka pro admina, např. „pro Pavla".
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  usedAt    DateTime?
  usedById  String?   @unique
  usedBy    User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Klient generuje ID sám (`proj-${Date.now()}`), což není globálně unikátní
/// napříč uživateli. Proto je primárním klíčem serverový cuid a klientské ID
/// žije vedle jako `clientId`, unikátní jen v rámci uživatele.
///
/// Všechno ostatní — název, ikona, štítek, priorita, stav, postup, termín,
/// zařazení do složek a seznam dokumentů — je uvnitř `ciphertext`.
model Project {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String

  createdAt    DateTime
  lastEditedAt DateTime

  ciphertext String
  nonce      String

  @@unique([userId, clientId])
  @@index([userId, lastEditedAt])
}

/// Stejný princip jako Project. Uvnitř `ciphertext` je název, popis, ikona,
/// Tiptap obsah, skica, styly, téma i zařazení do složek a štítků.
model Document {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String

  createdAt DateTime
  updatedAt DateTime

  ciphertext String
  nonce      String

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

/// Náhrada za zustand `persist` blob — složky, štítky, poznámky, rozložení
/// sidebaru, UI stav. `value` je zašifrovaný stejným hlavním klíčem; server
/// vidí jen název storu a klíč, což jsou konstanty z kódu, ne uživatelská data.
model Collection {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  key       String
  value     String
  nonce     String
  updatedAt DateTime @updatedAt

  @@id([userId, name, key])
}

/// Nahraná média. Obsah souboru je zašifrovaný v prohlížeči ještě před
/// odesláním; uvnitř šifrovaného bloku je i hlavička s původním MIME typem,
/// takže server nezná ani ten. Zná jen velikost, kvůli kvótě.
model MediaFile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cesta, kterou vidí klient a která je uložená v dokumentu.
  path       String
  /// Skutečné jméno souboru na disku serveru. Odděleno od `path`, aby
  /// klientská cesta nikdy neurčovala, kam se na serveru zapisuje.
  storageKey String @unique
  /// Velikost šifrovaného souboru. Jediné, co server o médiu ví.
  bytes      Int
  createdAt  DateTime @default(now())

  @@unique([userId, path])
  @@index([userId])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ukládá se jen hash — kdyby unikla databáze, samotné tokeny z ní nejdou
  /// získat.
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}
