// LockIn API — datový model
//
// Hybridní přístup: skalární sloupce pro to, co se filtruje a řadí (jméno,
// datum úpravy, oblíbenost, složka), `Json` pro obsah (Tiptap dokument,
// skica, styly). Tiptap JSON se tak neroztrhá na tabulky, ale Library filtry
// půjde časem přesunout na server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(USER)

  /// Kvóta na média v bajtech. Default 2 GB, admin může zvednout jednotlivci.
  /// BigInt, protože Int by přetekl u 2 GB+ (max ~2,1 mld.).
  storageQuota BigInt    @default(2147483648)
  /// Průběžně dopočítávaný součet MediaFile.bytes — ať se nemusí sčítat při
  /// každém uploadu.
  storageUsed  BigInt    @default(0)

  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  inviteCode    InviteCode?
  projects      Project[]
  documents     Document[]
  media         MediaFile[]
  collections   Collection[]
  refreshTokens RefreshToken[]

  @@index([createdAt])
}

/// Jednorázový — jeden kód = jeden účet. Po registraci se spálí (`usedAt`,
/// `usedById`), takže v administraci je vidět, kdo který kód použil a kdy.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  /// Volitelná poznámka pro admina, např. „pro Pavla".
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  usedAt    DateTime?
  usedById  String?   @unique
  usedBy    User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Klient generuje ID sám (`proj-${Date.now()}`), což není globálně unikátní
/// napříč uživateli — dva lidé mohou ve stejné milisekundě založit projekt se
/// stejným ID. Proto je primárním klíčem serverový cuid a klientské ID žije
/// vedle jako `clientId`, unikátní jen v rámci uživatele. API navenek posílá
/// a přijímá `clientId` jako `id`, takže klient o tomhle rozdílu neví.
model Project {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String

  name           String
  icon           String?
  tag            String
  priority       String
  status         String
  progress       Int      @default(0)
  deadline       String?
  deadlineTime   String?
  createdAt      DateTime
  lastEditedAt   DateTime
  rootDocumentId String
  documentIds    String[]
  isFavorite     Boolean  @default(false)
  folderId       String?
  tagIds         String[]

  @@unique([userId, clientId])
  @@index([userId, lastEditedAt])
}

model Document {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String

  /// clientId projektu, ne FK — samostatný dokument žádný projekt nemá a
  /// mazání projektu si kaskádu řeší aplikace, aby šlo dokumenty zachovat.
  projectId String?

  name                String
  description         String   @default("")
  icon                String?
  createdAt           DateTime
  updatedAt           DateTime
  lastMode            String   @default("text")
  folderId            String?
  tagIds              String[]
  isFavorite          Boolean  @default(false)
  isLocked            Boolean  @default(false)
  smallText           Boolean  @default(false)
  showTableOfContents Boolean  @default(false)

  /// Tiptap JSONContent
  text   Json
  /// { strokes: SketchStroke[] }
  sketch Json
  /// DocumentStyleConfig, volitelné
  style  Json?
  /// DocumentTheme, volitelné
  theme  Json?

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
  @@index([userId, projectId])
}

/// Náhrada za zustand `persist` blob. Mapuje se 1:1 na `KeyValueAdapter`:
/// `name` je logický store („ui-state.json"), `key` je klíč uvnitř něj.
/// Sem padají složky, tagy, poznámky, rozložení sidebaru a UI stav.
model Collection {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, name, key])
}

model MediaFile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cesta, kterou vidí klient a která je uložená v dokumentu —
  /// „Media/media-1234-abc.png". Zůstává stejná jako v desktopové verzi.
  path       String
  /// Skutečné jméno souboru na disku serveru. Odděleno od `path`, aby
  /// klientská cesta nikdy neurčovala, kam se na serveru zapisuje.
  storageKey String @unique
  mime       String
  bytes      Int
  createdAt  DateTime @default(now())

  @@unique([userId, path])
  @@index([userId])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ukládá se jen hash — kdyby unikla databáze, samotné tokeny z ní nejdou
  /// získat.
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}
